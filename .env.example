# ZeroClash Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# ==========================================
# Backend API & Server Settings
# ==========================================
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# Database Configuration
# ==========================================
# SQLite default for local development:
DATABASE_URL=sqlite:///zeroclash.db
# PostgreSQL for production/docker:
# DATABASE_URL=postgresql://zeroclash:zeroclash_secret@localhost:5432/zeroclash_db

# ==========================================
# Security & Authentication
# ==========================================
JWT_SECRET_KEY=zeroclash-jwt-secret-key-replace-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
QR_HMAC_SECRET=zeroclash-qr-hmac-tamper-proof-secret-token

# ==========================================
# Email Notification Alerts (Feature 2)
# When SMTP credentials are empty, system falls back to Console Notification Provider
# ==========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@zeroclash.campus.edu
SMTP_TLS=true

# ==========================================
# AI Scheduling Assistant (Feature 3)
# ==========================================
ANTHROPIC_API_KEY=
